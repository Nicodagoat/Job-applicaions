# ============================================================
# ENVIRONMENT VARIABLES
# ============================================================
# 1. Copy this file:  cp config/.env.example config/.env
# 2. Fill in the values you want
# 3. NEVER commit config/.env to git (it's gitignored)
# ============================================================

# ============================================================
# AI PROVIDER — Choose ONE (or let auto-detection decide)
# ============================================================

# ── Option 1: Ollama — FREE, runs on your machine ──────────
# Best for privacy. No data leaves your computer.
# 1. Download from https://ollama.com/download  (one-click install)
# 2. Open a terminal and run: ollama pull llama3.1
# 3. That's it — Ollama runs in the background automatically
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Option 2: DeepSeek — Very affordable cloud API ──────────
# Sign up at https://platform.deepseek.com
# ~$0.001 per cover letter — essentially free in practice
DEEPSEEK_API_KEY=

# ── Option 3: Groq — FREE cloud API ─────────────────────────
# Sign up at https://console.groq.com (completely free)
# Free tier: 30 requests/minute — more than enough
GROQ_API_KEY=

# ── Option 4: OpenAI — Paid (optional) ──────────────────────
# OPENAI_API_KEY=sk-...

# ============================================================
# JOB SOURCES — Free API keys to unlock more job listings
# ============================================================

# ── Adzuna — Free, covers UK + Germany + France + more ──────
# Register (free, 2 minutes) at: https://developer.adzuna.com/
# You'll get an App ID and App Key
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Reed.co.uk — Free, UK's largest job board ───────────────
# Register (free, 2 minutes) at: https://www.reed.co.uk/developers/jobseeker
REED_API_KEY=

# NOTE: Arbeitnow and Remotive work with NO keys at all.
# You'll get jobs immediately without filling anything in above.

# ============================================================
# NOTIFICATIONS — Get alerts on your phone ─────────────────
# ============================================================

# ── Telegram (recommended — free) ───────────────────────────
# Step 1: Open Telegram, search for @BotFather
# Step 2: Send /newbot  and follow the instructions
# Step 3: Copy the token it gives you here:
TELEGRAM_BOT_TOKEN=

# Step 4: Start a chat with your new bot (search its name)
# Step 5: Open this URL in your browser (replace YOUR_TOKEN):
#   https://api.telegram.org/botYOUR_TOKEN/getUpdates
# Step 6: Find "chat":{"id": XXXXXXXXX} and copy that number:
TELEGRAM_CHAT_ID=

# Test notifications work: python run.py notify-test

# ── ProtonMail — for email-based job applications ────────────
# Used when a job requires sending a CV + cover letter by email
# The platform logs in to ProtonMail web and sends the email for you
PROTONMAIL_EMAIL=
PROTONMAIL_PASSWORD=

# ── LinkedIn — for Easy Apply form auto-filling ──────────────
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ============================================================
# DATABASE — only needed if using PostgreSQL
# Default SQLite needs no configuration
# ============================================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=jobautomation
# DB_USER=postgres
# DB_PASSWORD=

# ============================================================
# SECURITY
# ============================================================
SECRET_KEY=please_change_this_to_something_random_and_long
