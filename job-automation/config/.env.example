# ============================================================
# ENVIRONMENT VARIABLES — copy this file to .env and fill in
# NEVER commit .env to git
# ============================================================

# ============================================================
# AI PROVIDER — choose ONE option (or let the system auto-detect)
# ============================================================

# ---- Option 1: Ollama (FREE, runs locally on your machine) ----
# Install Ollama from https://ollama.com/download
# Then run: ollama pull llama3.1
# Ollama starts automatically — no key needed!
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Option 2: Groq (FREE cloud API, LLaMA 3.1 70B) ----
# Sign up free at https://console.groq.com
# Create an API key (free tier is generous: 30 req/min)
GROQ_API_KEY=gsk_...

# ---- Option 3: OpenAI (paid, optional) ----
# OPENAI_API_KEY=sk-...

# ============================================================
# NOTIFICATIONS (optional but recommended)
# ============================================================

# ---- Telegram (recommended — free) ----
# 1. Message @BotFather on Telegram: /newbot
# 2. Copy the token below
# 3. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
# 4. Copy your chat id below
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Email fallback (optional) ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASSWORD=your_gmail_app_password

# ============================================================
# JOB BOARD CREDENTIALS (optional — for authenticated access)
# ============================================================
# LINKEDIN_EMAIL=your@email.com
# LINKEDIN_PASSWORD=yourpassword

# ============================================================
# DATABASE (optional — only needed for PostgreSQL)
# Default is SQLite which needs no configuration
# ============================================================
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=jobautomation
# DB_USER=postgres
# DB_PASSWORD=yourpassword

# ============================================================
# SECURITY
# ============================================================
SECRET_KEY=change_this_to_a_long_random_string_please
